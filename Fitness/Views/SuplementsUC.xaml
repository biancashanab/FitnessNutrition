<UserControl x:Class="Fitness.Views.SuplementsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fitness.Views"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="640">
    <UserControl.Resources>
        <!-- Existing Resources -->

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FF4060FC" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Width"
                    Value="200" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF5A77DD" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF3B57B3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10"
            Width="646"
            Opacity="0.9">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,2">
                <GradientStop Color="LightCyan"
                              Offset="0" />
                <GradientStop Color="gray"
                              Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="0,0,19,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Main Section -->
            <Grid Grid.Column="1"
                  Margin="10,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="179*" />
                    <RowDefinition Height="180*" />
                </Grid.RowDefinitions>

                <TextBox Name="textBoxSearch"
                         BorderBrush="LightBlue"
                         BorderThickness="3"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="354,6,69,179"
                         Grid.RowSpan="3"
                         Grid.Row="3" />
                <!-- Page Title -->
                <TextBlock Text="{Binding PageTitle}"
                           Grid.Row="1"
                           FontSize="32"
                           FontWeight="ExtraBold"
                           Margin="0,20,0,10"
                           Foreground="DarkBlue"
                           HorizontalAlignment="Center"
                           Grid.RowSpan="2" />
                <!-- Separator -->
                <Separator Grid.Row="1"
                           Height="1"
                           Background="#DAE2EA"
                           Margin="0,62,0,10"
                           Grid.RowSpan="2" />

                <!-- Tab Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="-1,8,1,179"
                            Grid.RowSpan="3">
                    <Button Content="Recipes"
                            Background="AliceBlue"
                            BorderBrush="Transparent"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Recipes"
                            Width="95" />
                    <Button Content="Exercises"
                            Background="AliceBlue"
                            BorderBrush="Transparent"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Exercises"
                            Width="93" />
                    <Button Content="Supplements"
                            Background="AliceBlue"
                            BorderBrush="Transparent"
                            Command="{Binding SelectCategoryCommand}"
                            CommandParameter="Supplements"
                            Width="120" />
                </StackPanel>

                <!-- Filter Title -->
                <TextBlock Text="Search"
                           Grid.Row="3"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,6,20,0"
                           Foreground="#121518"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           RenderTransformOrigin="0.443,0.22"
                           Height="20" />

                <!-- DataGrid -->
                <DataGrid x:Name="itemsDataGrid"
                          ItemsSource="{Binding Supplements}"
                          AutoGenerateColumns="False"
                          Margin="0,31,0,30"
                          Grid.Row="5"
                          Opacity="0.7"
                          Width="597"
                          HorizontalAlignment="Center"
                          Height="300"
                          Background="AliceBlue"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="itemsDataGrid_SelectionChanged"
                          Grid.RowSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding SupplementID}"
                                            Width="30" />
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="100" />
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="160" />
                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="70" />
                        <DataGridTextColumn Header="Dosage"
                                            Binding="{Binding Dosage}"
                                            Width="70" />
                        <DataGridTextColumn Header="Benefits"
                                            Binding="{Binding Benefits}"
                                            Width="140" />
                        <!--<DataGridTemplateColumn Header="Operations"
                                                Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="MOD"
                                                Margin="5,0,0,0"
                                                Background="Aqua"
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="DEL"
                                                Background="Aqua"
                                                Margin="5,0,0,0"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Vertical Separator (Optional) -->
            <Path Grid.Column="1"
                  Fill="Aqua"
                  HorizontalAlignment="Left"
                  Height="1"
                  Margin="95,144,0,0"
                  Stroke="Black"
                  Stretch="Fill"
                  VerticalAlignment="Top"
                  Width="1">
                <Path.Data>
                    <PathGeometry Figures="M96.666667,143.66667" />
                </Path.Data>
            </Path>
            <Border Opacity="0.8"
                    CornerRadius="10"
                    Grid.Column="1"
                    Margin="10,10,20,356">

            </Border>
        </Grid>
    </Border>
</UserControl>
