<!-- SettingsUC.xaml -->

<UserControl x:Class="Fitness.Views.SettingsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fitness.Views"
             xmlns:vm="clr-namespace:Fitness.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="BackgroundGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#80aaff"
                          Offset="0" />
            <GradientStop Color="#FFB06AB3"
                          Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FF4060FC" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Width"
                    Value="200" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF5A77DD" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#FF3B57B3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Rectangle HorizontalAlignment="Center"
                   Height="432"
                   Width="653"
                   Margin="0,58,0,0"
                   Stroke="White"
                   Fill="White"
                   Opacity="0.8"
                   VerticalAlignment="Top"
                   RadiusX="30"
                   RadiusY="30" />
        <Ellipse HorizontalAlignment="Center"
                 Height="119"
                 Width="127"
                 Margin="0,1,0,0"
                 Stroke="White"
                 Fill="White"
                 VerticalAlignment="Top" />
        <Image HorizontalAlignment="Left"
               Height="101"
               Width="106"
               Margin="299,10,0,0"
               VerticalAlignment="Top"
               Source="/Views/user.png" />

        <Grid HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="42,111,0,0"
              Width="634"
              Height="363">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <Grid>
                    <Grid Height="369"
                          VerticalAlignment="Top"
                          Margin="0,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0 - Name -->
                        <TextBlock Grid.Row="0"
                                   Text="Nume:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 FontSize="16"
                                 Foreground="Black"
                                 Width="150" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyNameCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 1 - Sex -->
                        <TextBlock Grid.Row="1"
                                   Text="Sex:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding SexOptions}"
                                  SelectedItem="{Binding Sex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  FontSize="16"
                                  Foreground="Black" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifySexCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 2 - Height -->
                        <TextBlock Grid.Row="2"
                                   Text="Înălțime:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 FontSize="16"
                                 Foreground="Black"
                                 Width="150" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyHeightCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 3 - Weight -->
                        <TextBlock Grid.Row="3"
                                   Text="Greutate:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 FontSize="16"
                                 Foreground="Black"
                                 Width="150" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyWeightCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 4 - User Type -->
                        <TextBlock Grid.Row="4"
                                   Text="Tip Utilizator:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <ComboBox Grid.Row="4"
                                  Grid.Column="1"
                                  ItemsSource="{Binding UserTypeOptions}"
                                  SelectedItem="{Binding UserType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  FontSize="16"
                                  Foreground="Black" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="4"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyUserTypeCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 5 - Physical Condition -->
                        <TextBlock Grid.Row="5"
                                   Text="Conditie Fizica:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding PhysicalCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 FontSize="16"
                                 Foreground="Black"
                                 Width="150" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="5"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyUserPhysicalCondCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 6 - Activity Level -->
                        <TextBlock Grid.Row="6"
                                   Text="Nivel Activitate:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <ComboBox Grid.Row="6"
                                  Grid.Column="1"
                                  ItemsSource="{Binding ActivityOptions}"
                                  SelectedItem="{Binding Activity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  FontSize="16"
                                  Foreground="Black" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="6"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyUserActivityCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>

                        <!-- Row 7 - Meal Plan -->
                        <TextBlock Grid.Row="7"
                                   Text="Plan Alimentar:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <ComboBox Grid.Row="7"
                                  Grid.Column="1"
                                  ItemsSource="{Binding MealOptions}"
                                  SelectedItem="{Binding Meal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  FontSize="16"
                                  Foreground="Black" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="7"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyUserMealPlanCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>


                        <!-- Row 8 - Workout Plan -->
                        <TextBlock Grid.Row="8"
                                   Text="Plan Antrenament:"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="Black" />
                        <ComboBox Grid.Row="8"
                                  Grid.Column="1"
                                  ItemsSource="{Binding WorkoutOptions}"
                                  SelectedItem="{Binding Workout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="150"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  FontSize="16"
                                  Foreground="Black" />
                        <Button BorderBrush="Transparent"
                                Background="Transparent"
                                Grid.Row="8"
                                Grid.Column="2"
                                Margin="5"
                                Padding="8"
                                Command="{Binding ModifyUserWorkoutPlanCommand}">
                            <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                  Fill="Black"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16" />
                        </Button>
                    </Grid>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
