<UserControl x:Class="Fitness.Views.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fitness.Views"
             xmlns:vm="clr-namespace:Fitness.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">

    <Grid Margin="15,0,0,0">
        <ContentControl Name="DynamicContent"
                        Content="{Binding CurrentUC}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top" />

        <StackPanel x:Name="Main_content"
                    Visibility="{Binding MainContentVisibility}">
            <TextBlock Text="Discover"
                       Foreground="White"
                       HorizontalAlignment="Left"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="20,-10,0,20" />

            <StackPanel Orientation="Horizontal"
                        Margin="20,0,20,10">
                <Border Width="400"
                        Height="200">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,2">
                            <GradientStop Color="LightGreen"
                                          Offset="0" />
                            <GradientStop Color="#3aa0ff"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Clip>
                        <RectangleGeometry RadiusX="10"
                                           RadiusY="10"
                                           Rect="0,0,400,200" />
                    </Border.Clip>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="You can &#x0a;be powerfull"
                                       Foreground="White"
                                       FontSize="28"
                                       Margin="20,10,10,0" />

                            <TextBlock Text="Get started today!"
                                       Foreground="White"
                                       FontSize="18"
                                       Margin="20,10,10,0" />
                        </StackPanel>
                        <Image Margin="188,0,0,-11"
                               Source="/Poze/sport.png" />
                    </Grid>
                </Border>

                <Border Opacity="0.8"
                        Width="210"
                        Height="227"
                        CornerRadius="10"
                        Margin="30,0,20,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,2">
                            <GradientStop Color="#ffccff"
                                          Offset="0" />
                            <GradientStop Color="gray"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel Margin="10">
                        <TextBlock Text="Weight History"
                                   Foreground="Black"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,00" />

                        <!-- Weight History Graph -->
                        <lvc:CartesianChart Height="151">
                            <lvc:CartesianChart.Series>
                                <lvc:LineSeries Values="{Binding WeightChartValues}"
                                                Title="Weight"
                                                PointGeometrySize="10" />
                            </lvc:CartesianChart.Series>
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding WeightDates}"
                                          Title="Date" />
                            </lvc:CartesianChart.AxisX>
                        </lvc:CartesianChart>


                        <!-- Input box and submit button -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0">
                            <TextBox Width="80"
                                     Height="25"
                                     Text="{Binding NewWeight, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center" />
                            <Button Content="Submit"
                                    Command="{Binding SubmitWeightCommand}"
                                    Width="60"
                                    Height="25"
                                    Opacity="0.8"
                                    BorderThickness="2,2,2,2"
                                    BorderBrush="#FF205CA8"
                                    Background="#FF0040F0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
            <StackPanel Height="217">


                <StackPanel.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Margin"
                                Value="15,0,0,0" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Your Stats"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Margin="22,10,0,20" />

                <StackPanel Orientation="Horizontal"
                            Margin="20,0,20,0">
                    <Border Width="150"
                            Height="150"
                            Background="#844eff"
                            CornerRadius="10"
                            Margin="0">
                        <Button x:Name="meal_btn"
                                HorizontalAlignment="Center"
                                Width="150"
                                Margin="0,10,0,10"
                                FontSize="16"
                                BorderThickness="0,0,0,0"
                                Command="{Binding NavigateToMealCommand}"
                                Content="">
                            <Button.Background>
                                <ImageBrush />
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage"
                                               Source="/Poze/meal.png" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="true">
                                            <Setter TargetName="ButtonImage"
                                                    Property="Source"
                                                    Value="/Poze/meal_click.png" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border Width="150"
                            Height="150"
                            Background="#4e99ff"
                            CornerRadius="10">
                        <Button x:Name="workout_btn"
                                HorizontalAlignment="Center"
                                Width="150"
                                Margin="0,10,0,10"
                                FontSize="16"
                                BorderThickness="0,0,0,0"
                                Command="{Binding NavigateToWorkoutCommand}"
                                Content="">
                            <Button.Background>
                                <ImageBrush />
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage"
                                               Source="/Poze/workout.png" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="true">
                                            <Setter TargetName="ButtonImage"
                                                    Property="Source"
                                                    Value="/Poze/workout_click.png" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border Width="150"
                            Height="150"
                            Background="#4eff91"
                            CornerRadius="10">
                        <Grid>
                            <TextBlock Text="Daily kcal:"
                                       Foreground="DarkCyan"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,10,0,0" />
                            <TextBlock 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="48"
                                       Foreground="DarkCyan"
                                       FontWeight="ExtraBold"
                                       Text="{Binding Calorie}"></TextBlock>
                           
                        </Grid>
                    </Border>
                    <Border Width="150"
                            Height="150"
                            Background="#ecff4e"
                            CornerRadius="10">
                        <Button x:Name="suplements_btn"
                                HorizontalAlignment="Center"
                                Width="150"
                                Margin="0,10,0,10"
                                FontSize="16"
                                BorderThickness="0,0,0,0"
                                Command="{Binding NavigateToSupplementsCommand}"
                                Content="">
                            <Button.Background>
                                <ImageBrush />
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage"
                                               Source="/Poze/supplements.png" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="true">
                                            <Setter TargetName="ButtonImage"
                                                    Property="Source"
                                                    Value="/Poze/supplements_click.png" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
