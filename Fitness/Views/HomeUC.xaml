<UserControl x:Class="Fitness.Views.HomeUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fitness.Views"
             xmlns:vm="clr-namespace:Fitness.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.DataContext>
        <vm:HomeVM/>
    </UserControl.DataContext>
    <Grid Margin="15,0,0,0">
        <ContentControl Name="DynamicContent" Content="{Binding CurrentUC}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

        <StackPanel x:Name="Main_content" Visibility="{Binding MainContentVisibility}">
            <TextBlock Text="Discover"
                   Foreground="White"
                   HorizontalAlignment="Left"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="20,0,0,20"/>

            <StackPanel Orientation="Horizontal"
                    Margin="20,0,20,10">
                <Border Width="400" 
                    Height="200">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                            <GradientStop Color="LightGreen" Offset="0"/>
                            <GradientStop Color="#3aa0ff" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Clip>
                        <RectangleGeometry RadiusX="10"
                                       RadiusY="10"
                                       Rect="0,0,400,200"/>
                    </Border.Clip>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="You can &#x0a;be powerfull"
                                   Foreground="White"
                                   FontSize="28"
                                   Margin="20,10,10,0"/>

                            <TextBlock Text="Get started today!"
                                   Foreground="White"
                                   FontSize="18"
                                   Margin="20,10,10,0"/>
                        </StackPanel>
                        <Image Margin="188,0,0,-11" Source="/Poze/sport.png"
                           />
                    </Grid>
                </Border>

                <Border
                Opacity="0.8" Width="210"  Height="200"  CornerRadius="10"  Margin="30,0,20,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                            <GradientStop Color="#ffccff" Offset="0"/>
                            <GradientStop Color="gray" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

            </StackPanel>
            <StackPanel Height="217">


                <StackPanel.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Margin" Value="15,0,0,0"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="Your Stats"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="22,10,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,20,0">
                    <Border Width="150"
                        Height="150"
                        Background="#844eff"
                        CornerRadius="10"
                        Margin="0">
                        <Button x:Name="meal_btn" HorizontalAlignment="Center"
                            Width="150" Margin="0,10,0,10" FontSize="16"
                            BorderThickness="0,0,0,0"
                            Command="{Binding NavigateToMealCommand}" Content="">
                            <Button.Background>
                                <ImageBrush/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage" Source="/Poze/meal.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="ButtonImage" Property="Source" Value="/Poze/meal_click.png"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border Width="150"
                        Height="150"
                        Background="#4e99ff"
                        CornerRadius="10">
                        <Button x:Name="workout_btn" HorizontalAlignment="Center"
                            Width="150" Margin="0,10,0,10" FontSize="16"
                            BorderThickness="0,0,0,0"
                            Command="{Binding NavigateToWorkoutCommand}" Content="">
                            <Button.Background>
                                <ImageBrush/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage" Source="/Poze/workout.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="ButtonImage" Property="Source" Value="/Poze/workout_click.png"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                    <Border Width="150"
                        Height="150"
                        Background="#4eff91"
                        CornerRadius="10" />
                    <Border Width="150"
                        Height="150"
                        Background="#ecff4e"
                        CornerRadius="10" >
                        <Button x:Name="suplements_btn" HorizontalAlignment="Center"
                            Width="150" Margin="0,10,0,10" FontSize="16"
                            BorderThickness="0,0,0,0"
                            Command="{Binding NavigateToSupplementsCommand}" Content="">
                            <Button.Background>
                                <ImageBrush/>
                            </Button.Background>
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border>
                                        <Image x:Name="ButtonImage" Source="/Poze/supplements.png"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="ButtonImage" Property="Source" Value="/Poze/supplements_click.png"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

    </Grid>
</UserControl>
