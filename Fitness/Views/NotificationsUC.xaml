<UserControl x:Class="Fitness.Views.NotificationsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fitness.Views"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700">
    <UserControl.Resources>
        <!-- Button Style -->
        <Style x:Key="ElegantButtonStyle"
               TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="#1E3A8A"
                                      Offset="0.0" />
                        <GradientStop Color="#3B82F6"
                                      Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground"
                    Value="Wheat" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="Width"
                    Value="220" />
            <Setter Property="Height"
                    Value="60" />
            <Setter Property="Margin"
                    Value="10" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="30"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border CornerRadius="30"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      Direction="320"
                                                      ShadowDepth="5"
                                                      Opacity="0.3"
                                                      BlurRadius="10" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#3B82F6"
                                                          Offset="0.0" />
                                            <GradientStop Color="#60A5FA"
                                                          Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#1E40AF"
                                                          Offset="0.0" />
                                            <GradientStop Color="#3B82F6"
                                                          Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#A0AEC0" />
                                <Setter Property="Foreground"
                                        Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Define the main Grid with two columns -->
    <Grid Background="Transparent"
          Margin="0,0,10,0">

        <Grid.ColumnDefinitions>
            <!-- Left Column for Buttons -->
            <ColumnDefinition Width="Auto" />
            <!-- Right Column for Text -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="LightBlue"
                CornerRadius="10"
                Opacity="0.5"
                Grid.Column="1"
                Margin="21,28,327,80" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="16"
                   FontFamily="Algerian"
                   Foreground="AliceBlue"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Margin="41,60,0,0"
                   Grid.ColumnSpan="2"
                   Width="307"
                   Height="270">
            <TextBlock.Text>
                Our experts are ready to create you a fully personalized workout and meal plan. All you have to do is click a button, and in moments, an expert will start to analyze your state and create the best possible plan for your needs.
            </TextBlock.Text>
        </TextBlock>
        <!-- Left Side: Buttons -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="62,225,0,0"
                    Orientation="Vertical"
                    Width="264"
                    Grid.ColumnSpan="2">
            <Button x:Name="RequestMealPlanButton"
                    Content="Request Meal Plan"
                    Command="{Binding RequestMealPlanCommand}"
                    Style="{StaticResource ElegantButtonStyle}" />

            <Button x:Name="RequestWorkoutPlanButton"
                    Content="Request Workout Plan"
                    Command="{Binding RequestWorkoutPlanCommand}"
                    Style="{StaticResource ElegantButtonStyle}" />
        </StackPanel>

        <Image Margin="326,120,-38,120"
                   Source="/Poze/notif.png"
                   Stretch="Fill"
                   Grid.ColumnSpan="2" />
        <!-- Right Side: Descriptive Text -->

    </Grid>
</UserControl>
