<UserControl x:Class="Fitness.Views.NutritionistNotificationsUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Fitness.Views"
             mc:Ignorable="d"
             d:DesignWidth="600"
             Height="487">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="GradientBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="LightBlue"
                          Offset="0" />
            <GradientStop Color="SkyBlue"
                          Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="RoundedButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="SteelBlue" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Opacity"
                    Value="0.6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="15"
            Background="{StaticResource GradientBackground}"
            Margin="10,0,10,10">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="199*" />
                <ColumnDefinition Width="71*" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="15"
                    Background="LightBlue"
                    Opacity="0.8"
                    Padding="10"
                    Grid.ColumnSpan="2"
                    Margin="0,59,0,0">
                <StackPanel>
                    <ListView x:Name="UserListView_Copy"
                              ItemsSource="{Binding Users}"
                              Margin="0,0,0,20"
                              d:ItemsSource="{d:SampleData ItemCount=5}"
                              Height="170">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID"
                                                DisplayMemberBinding="{Binding Id}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Name"
                                                DisplayMemberBinding="{Binding Name}"
                                                Width="120">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Sex"
                                                DisplayMemberBinding="{Binding Sex}"
                                                Width="70">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Height"
                                                DisplayMemberBinding="{Binding Height}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Weight"
                                                DisplayMemberBinding="{Binding Weight}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Actions"
                                                Width="140">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Generate Meal Plan"
                                                    Command="{Binding DataContext.GenerateMealPlanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView x:Name="UserListView_Second"
                              ItemsSource="{Binding Users2}"
                              Height="170"
                              d:ItemsSource="{d:SampleData ItemCount=6}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID"
                                                DisplayMemberBinding="{Binding Id}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Name"
                                                DisplayMemberBinding="{Binding Name}"
                                                Width="120">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Sex"
                                                DisplayMemberBinding="{Binding Sex}"
                                                Width="70">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Height"
                                                DisplayMemberBinding="{Binding Height}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Weight"
                                                DisplayMemberBinding="{Binding Weight}"
                                                Width="90">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                </GridViewColumn>
                                <GridViewColumn Header="Actions"
                                                Width="140">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="{x:Type GridViewColumnHeader}">
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Generate Workout Plan"
                                                    Command="{Binding DataContext.GenerateWorkoutPlanCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RoundedButtonStyle}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
            <Border VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    CornerRadius="15"
                    Height="50"
                    Width="500"
                    Background="DarkSeaGreen"
                    Opacity="0.8"
                    Margin="20,4,0,0"
                    Grid.ColumnSpan="2">
                <TextBlock Text="Meal&amp;Workout request panel"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           FontFamily="Algerian"
                           Foreground="DarkBlue" />
            </Border>
        </Grid>
    </Border>
</UserControl>
